// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// The requester's ask — kept intentionally broad since one form covers all
// twelve request types for now; per-type question sets are a documented gap.
enum RequestType {
  CAMPAIGN
  WEBSITE_CHANGE
  BLOG_OR_SOCIAL_CONTENT
  CUSTOMER_EMAIL
  ADVERTISEMENT
  LOGO_OR_CREATIVE_ASSET
  PRINT_COLLATERAL
  RECRUITING_SUPPORT
  JOB_FAIR_OR_EVENT
  PROMOTIONAL_PRODUCT
  PHOTO_OR_VIDEO
  SPONSORSHIP
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  BLOCKED
  IN_APPROVAL
  COMPLETED
  REJECTED
}

// The central object of the whole product: the request/campaign/business
// change, not the individual channel post. Everything else (creation,
// approval, publishing, verification) hangs off this spine.
model MarketingRequest {
  id            String           @id @default(cuid())
  type          RequestType
  title         String
  description   String?
  requesterName String
  department    String?
  priority      RequestPriority  @default(NORMAL)
  status        RequestStatus    @default(NEW)
  owner         String?
  missingInfo   String?
  dueDate       DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  activities Activity[]
  drafts     ContentDraft[]
}

// Auto-logged on every status change, owner assignment, and note — the
// lightweight automation/timeline engine, same pattern as every other
// product in this family.
model Activity {
  id                 String           @id @default(cuid())
  marketingRequestId String
  marketingRequest   MarketingRequest @relation(fields: [marketingRequestId], references: [id], onDelete: Cascade)
  type               String
  message            String
  createdAt          DateTime         @default(now())
}

// Only three channels for now — enough to prove genuine per-channel
// adaptation (blog vs. LinkedIn vs. X), not a full multichannel matrix yet.
enum ContentChannel {
  BLOG
  LINKEDIN
  X
}

enum DraftStatus {
  DRAFT
  APPROVED
}

// One request generates a package of channel-adapted drafts in one AI call —
// the "one brief becomes a coordinated package" promise, scoped down to a
// first, provable slice.
model ContentDraft {
  id         String           @id @default(cuid())
  requestId  String
  request    MarketingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  channel    ContentChannel
  body       String
  status     DraftStatus      @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  publishAttempts PublishAttempt[]
}

// The "verification and operational memory" the product spec calls for —
// what published, where, and what failed. One row per publish click, success
// or failure, so a broken/expired credential shows up honestly instead of
// silently doing nothing.
model PublishAttempt {
  id          String       @id @default(cuid())
  draftId     String
  draft       ContentDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  destination String
  success     Boolean
  url         String?
  error       String?
  createdAt   DateTime     @default(now())
}

// Singleton (fixed id "brand") — Noticed serves one company, not multiple
// tenants, so there's exactly one brand to remember. Scoped to the textual
// voice/positioning fields that actually feed the content-generation prompt;
// logos/colors/typography already live as real assets (public/logo-*.png,
// globals.css) and version history / prior-campaign-results are a much
// bigger, undecided piece of area 4 — not built here.
model BrandProfile {
  id                 String   @id @default("brand")
  voice              String?
  audiences          String?
  positioning        String?
  approvedLanguage   String?
  prohibitedLanguage String?
  updatedAt          DateTime @updatedAt
}
