// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Single-owner, multiple brand voices — NOT multi-tenant (no client
// workspaces, no customer accounts, no auth boundary between brands, just
// keeping one person's several voices from blending). The true entry-point
// models (MarketingRequest, KnowledgeRecord, ContentProject, Idea) get a
// direct brandId; everything else (drafts, activities, publish attempts,
// the request/idea<->project relation tables) derives brand through its
// parent relation rather than duplicating the column everywhere.
model Brand {
  id        String  @id @default(cuid())
  key       String  @unique
  name      String
  isDefault Boolean @default(false)

  requests         MarketingRequest[]
  knowledgeRecords KnowledgeRecord[]
  contentProjects  ContentProject[]
  ideas            Idea[]
}

// The requester's ask — kept intentionally broad since one form covers all
// twelve request types for now; per-type question sets are a documented gap.
enum RequestType {
  CAMPAIGN
  WEBSITE_CHANGE
  BLOG_OR_SOCIAL_CONTENT
  CUSTOMER_EMAIL
  ADVERTISEMENT
  LOGO_OR_CREATIVE_ASSET
  PRINT_COLLATERAL
  RECRUITING_SUPPORT
  JOB_FAIR_OR_EVENT
  PROMOTIONAL_PRODUCT
  PHOTO_OR_VIDEO
  SPONSORSHIP
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  BLOCKED
  IN_APPROVAL
  COMPLETED
  REJECTED
}

// The central object of the whole product: the request/campaign/business
// change, not the individual channel post. Everything else (creation,
// approval, publishing, verification) hangs off this spine.
model MarketingRequest {
  id            String           @id @default(cuid())
  brandId       String
  brand         Brand            @relation(fields: [brandId], references: [id])
  type          RequestType
  title         String
  description   String?
  requesterName String
  department    String?
  priority      RequestPriority  @default(NORMAL)
  status        RequestStatus    @default(NEW)
  owner         String?
  missingInfo   String?
  dueDate       DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  activities Activity[]
  // MarketingRequest no longer parents ContentDraft directly — it reaches
  // content through a ContentProject (see MarketingRequestContentProject),
  // the same door Creator Studio's Idea model uses. A request represents a
  // company-marketing-operations ask; it is a different real-world thing
  // from a personal idea, so the two intake models stay separate even
  // though both can produce drafts through the same shared ContentProject.
  contentProjects MarketingRequestContentProject[]
}

// Auto-logged on every status change, owner assignment, and note — the
// lightweight automation/timeline engine, same pattern as every other
// product in this family.
model Activity {
  id                 String           @id @default(cuid())
  marketingRequestId String
  marketingRequest   MarketingRequest @relation(fields: [marketingRequestId], references: [id], onDelete: Cascade)
  type               String
  message            String
  createdAt          DateTime         @default(now())
}

// Only three channels for now — enough to prove genuine per-channel
// adaptation (blog vs. LinkedIn vs. X), not a full multichannel matrix yet.
enum ContentChannel {
  BLOG
  LINKEDIN
  X
}

enum DraftStatus {
  DRAFT
  APPROVED
}

// The shared production parent for every piece of content, regardless of
// which door it came through. A ContentProject is created either from a
// personal Idea (Creator Studio) or triaged from a MarketingRequest
// (Marketing Operations) — via the two join models below — but it can also
// exist on its own, with neither. ContentDraft belongs to exactly one
// ContentProject; it never depends on which intake method produced it.
enum ContentProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model ContentProject {
  id        String               @id @default(cuid())
  brandId   String
  brand     Brand                @relation(fields: [brandId], references: [id])
  title     String
  premise   String?
  status    ContentProjectStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  // onDelete is deliberately NOT Cascade on ContentDraft's side (see below)
  // — a project with real drafts can't be casually deleted. These two join
  // tables are pure linkage bookkeeping, not content, so cascading their
  // own rows when a project is deleted is safe and just tidies up.
  drafts            ContentDraft[]
  marketingRequests MarketingRequestContentProject[]
  ideas             IdeaContentProject[]
  recordings        Recording[]
}

// A raw audio capture plus its local transcription. The file itself lives
// on disk (see RECORDINGS_DIR in src/lib/services/recordings.ts) — only the
// path is stored here, same "never BLOB the media" rule as the rest of this
// app. Transcription runs locally via whisper.cpp; no audio or transcript
// text is ever sent to a model API.
enum RecordingStatus {
  UPLOADED
  TRANSCRIBING
  TRANSCRIBED
  FAILED
}

model Recording {
  id               String          @id @default(cuid())
  contentProjectId String
  contentProject   ContentProject  @relation(fields: [contentProjectId], references: [id], onDelete: Restrict)
  filePath         String
  mimeType         String
  durationSeconds  Float?
  status           RecordingStatus @default(UPLOADED)
  // Plain-text transcript for quick display/search, plus the segment-level
  // (not word-level — see docs/media-studio-feasibility.md point 8 for why
  // that distinction was deliberate) timestamps as JSON.
  transcript         String?
  transcriptSegments String?
  transcriptError    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

// Personal, format-less capture — "there's something here," before it's
// decided whether it becomes a blog, a podcast, or a social post. Brand is
// required directly (same pattern as MarketingRequest/KnowledgeRecord —
// the true entry-point models get a direct brandId).
enum IdeaStatus {
  CAPTURED
  DEVELOPING
  PROMOTED
  ARCHIVED
}

model Idea {
  id        String     @id @default(cuid())
  brandId   String
  brand     Brand      @relation(fields: [brandId], references: [id])
  content   String
  source    String?
  status    IdeaStatus @default(CAPTURED)
  createdAt DateTime   @default(now())

  contentProjects IdeaContentProject[]
}

// Relation table, not a direct FK on either side — a MarketingRequest can
// spawn more than one ContentProject (e.g. one campaign ask producing a
// separate blog project and a separate social-only project), and one
// ContentProject can in principle satisfy more than one request. Deleting
// this row only removes the link; it never deletes the request or the
// project on either side. onDelete: Cascade here means "when the request
// itself is deleted, its links disappear too" — the project and its
// drafts are untouched, since this table doesn't own them.
model MarketingRequestContentProject {
  id                 String           @id @default(cuid())
  marketingRequestId String
  marketingRequest   MarketingRequest @relation(fields: [marketingRequestId], references: [id], onDelete: Cascade)
  contentProjectId   String
  contentProject     ContentProject   @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@unique([marketingRequestId, contentProjectId])
}

// Same shape as MarketingRequestContentProject, for Idea instead — one
// idea can grow into multiple projects, and a project can combine more
// than one idea. Deleting an Idea only removes this link, never the
// project or its drafts.
model IdeaContentProject {
  id               String         @id @default(cuid())
  ideaId           String
  idea             Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  contentProjectId String
  contentProject   ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([ideaId, contentProjectId])
}

// One request generates a package of channel-adapted drafts in one AI call —
// the "one brief becomes a coordinated package" promise, scoped down to a
// first, provable slice.
model ContentDraft {
  id               String         @id @default(cuid())
  // The ONLY parent — every ContentDraft belongs to exactly one
  // ContentProject, full stop. There is no second, competing way to
  // determine ownership (no requestId here anymore): a draft never has to
  // fabricate a MarketingRequest to exist, and it never has two possible
  // parents to reconcile. onDelete: Restrict — a ContentProject with real
  // drafts cannot be deleted; drafts must be reassigned or removed first.
  contentProjectId String
  contentProject   ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Restrict)
  channel    ContentChannel
  // Falls back to the parent project's title when null (the normal
  // one-project-to-few-drafts flow). Bulk-imported drafts set their own,
  // since many drafts share one container project and need to be
  // individually identifiable on the calendar.
  title      String?
  body       String
  status     DraftStatus      @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?

  // When this post is meant to go out — the calendar's whole reason for
  // existing. Null means "not scheduled yet."
  scheduledFor DateTime?

  // Set by an independent second AI call that checks the generated package
  // against every APPROVED PROHIBITED_CLAIM/PROHIBITED_TERM record — null
  // means clean. Non-null blocks the normal one-field approval form; the
  // approver must supply an override reason instead, so a flag can't just
  // be silently dismissed.
  complianceFlag      String?
  complianceCheckedAt DateTime?

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  publishAttempts PublishAttempt[]
  knowledgeLinks  ContentDraftKnowledgeRecord[]
}

// The "verification and operational memory" the product spec calls for —
// what published, where, and what failed. One row per publish click, success
// or failure, so a broken/expired credential shows up honestly instead of
// silently doing nothing.
model PublishAttempt {
  id          String       @id @default(cuid())
  draftId     String
  draft       ContentDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  destination String
  success     Boolean
  url         String?
  error       String?
  createdAt   DateTime     @default(now())
}

// Replaces the old BrandProfile free-text blob (2026-07-27) — a single
// prose field has no source, no status, no way to distinguish "the owner
// approved this" from "the AI invented this," which is exactly how
// "litigation-ready" ended up in a draft undetected. Every fact/rule/claim
// is its own row instead, so it can be individually sourced, approved,
// deprecated, and checked against.
//
// No workspace/tenant fields — Noticed is single-owner/local right now
// (see [[project_noticed]] memory), so every record implicitly belongs to
// the one brand being managed. Deliberately NOT building multi-tenant
// scoping for a database with one user; that's a real rebuild for if/when
// productization happens, not an incremental add now.
enum KnowledgeType {
  COMPANY_FACT
  AUDIENCE
  VOICE_RULE
  POSITIONING
  APPROVED_TERM
  PROHIBITED_TERM
  APPROVED_CLAIM
  PROHIBITED_CLAIM
  OFFER
  STANDING_INSTRUCTION
  SOURCE_DOCUMENT
}

enum KnowledgeStatus {
  PROPOSED
  APPROVED
  DEPRECATED
}

model KnowledgeRecord {
  id        String          @id @default(cuid())
  brandId   String
  brand     Brand           @relation(fields: [brandId], references: [id])
  type      KnowledgeType
  title     String
  content   String
  source    String?
  status    KnowledgeStatus @default(PROPOSED)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  draftLinks ContentDraftKnowledgeRecord[]
  activities KnowledgeRecordActivity[]
}

// Same auto-log pattern as Activity/PublishAttempt elsewhere in the app —
// every status change and edit gets a row, so knowledge governance has the
// same audit trail as everything else.
model KnowledgeRecordActivity {
  id                String          @id @default(cuid())
  knowledgeRecordId String
  knowledgeRecord   KnowledgeRecord @relation(fields: [knowledgeRecordId], references: [id], onDelete: Cascade)
  message           String
  createdAt         DateTime        @default(now())
}

// Lineage: which approved knowledge was in scope when a draft was
// generated. Scoped honestly — this records "these records were part of
// the generation context," not per-sentence attribution (the model isn't
// asked to cite which fact produced which line; that's a real limitation).
model ContentDraftKnowledgeRecord {
  id                String          @id @default(cuid())
  contentDraftId    String
  contentDraft      ContentDraft    @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  knowledgeRecordId String
  knowledgeRecord   KnowledgeRecord @relation(fields: [knowledgeRecordId], references: [id], onDelete: Cascade)

  @@unique([contentDraftId, knowledgeRecordId])
}

// --- MCP OAuth (single-owner ChatGPT Connect) ---
// No multi-user accounts: authorize with NOTICED_OWNER_PASSWORD; subject is always "owner".

model McpOAuthClient {
  clientId                 String   @id @map("client_id")
  clientSecretHash         String?  @map("client_secret_hash")
  clientName               String?  @map("client_name")
  redirectUris             String   @map("redirect_uris") // JSON string[]
  tokenEndpointAuthMethod  String   @default("none") @map("token_endpoint_auth_method")
  createdAt                DateTime @default(now()) @map("created_at")

  authorizationCodes McpOAuthAuthorizationCode[]
  accessTokens       McpOAuthAccessToken[]
  refreshTokens      McpOAuthRefreshToken[]
}

model McpOAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique @map("code_hash")
  clientId            String    @map("client_id")
  client              McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId              String    @map("user_id")
  redirectUri         String    @map("redirect_uri")
  codeChallenge       String    @map("code_challenge")
  codeChallengeMethod String    @default("S256") @map("code_challenge_method")
  scopes              String    @default("[]") // JSON string[]
  expiresAt           DateTime  @map("expires_at")
  usedAt              DateTime? @map("used_at")
  createdAt           DateTime  @default(now()) @map("created_at")
}

model McpOAuthAccessToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique @map("token_hash")
  clientId    String    @map("client_id")
  client      McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId      String    @map("user_id")
  scopes      String    @default("[]") // JSON string[]
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  refreshTokens McpOAuthRefreshToken[]
}

model McpOAuthRefreshToken {
  id            String    @id @default(cuid())
  tokenHash     String    @unique @map("token_hash")
  accessTokenId String?   @map("access_token_id")
  accessToken   McpOAuthAccessToken? @relation(fields: [accessTokenId], references: [id], onDelete: SetNull)
  clientId      String    @map("client_id")
  client        McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId        String    @map("user_id")
  scopes        String    @default("[]") // JSON string[]
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
}
